{
  "name": "qrcraftly",
  "description": "A powerful, privacy-focused, and user-friendly React application for generating customized QR codes.",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "homepage": "https://qrcraftly.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/fderuiter/QRCraftly.git"
  },
  "keywords": [
    "qr-code",
    "generator",
    "react",
    "privacy-focused",
    "customizable"
  ],
  "scripts": {
    "predev": "node scripts/compile_docs_manifest.js",
    "dev": "vite",
    "build": "node scripts/compile_docs_manifest.js && vite build && pnpm run postbuild",
    "postbuild": "node scripts/generate_sw.cjs && node scripts/bundle_ast_audit.js && npx tsx scripts/generate_sitemap.ts && node scripts/csp_hash_injector.js && node scripts/generate_lhci_manifest.js && node scripts/patch_wrangler.js && node scripts/patch_github_action.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "lint": "node scripts/dependency_compliance.js && node scripts/git_lineage_auditor.js && node scripts/validate_ui_catalog.js && node scripts/audit_markdown.js && node scripts/static-path-tracker.js && node scripts/compile_docs_manifest.js && tsc --noEmit && eslint . && knip && node scripts/contrast_check.js && prettier --check . && node scripts/check-duplication.js",
    "validate:ui-catalog": "node scripts/validate_ui_catalog.js",
    "validate:duplication": "node scripts/check-duplication.js",
    "format:classes": "node scripts/sort_tailwind_classes.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-bundle-size": "node scripts/check-bundle-size.js",
    "bundle-size": "node scripts/check-bundle-size.js",
    "resource-quota-report": "node scripts/resource-quota-report.js",
    "resource-quota": "node scripts/resource-quota-report.js",
    "secret-scanner": "node scripts/secret-scanner.js",
    "secret-scan": "node scripts/secret-scanner.js",
    "prepare": "simple-git-hooks",
    "pre-commit": "lint-staged && pnpm run validate:duplication"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vike": "^0.4.247",
    "vike-react": "^0.6.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jscpd": "^5.0.16",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "marked": "^18.0.11",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.125.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run pre-commit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "simple-git-hooks"
    ]
  }
}
