{
  "name": "qrcraftly",
  "description": "A powerful, privacy-focused, and user-friendly React application for generating customized QR codes.",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "homepage": "https://qrcraftly.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/fderuiter/QRCraftly.git"
  },
  "keywords": [
    "qr-code",
    "generator",
    "react",
    "privacy-focused",
    "customizable"
  ],
  "scripts": {
    "predev": "node scripts/compile_docs_manifest.js",
    "dev": "vite",
    "prebuild": "node scripts/git_lineage_auditor.js && node scripts/audit_markdown.js && node scripts/compile_docs_manifest.js && eslint .",
    "build": "vite build",
    "postbuild": "node scripts/generate_sitemap.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "lint": "node scripts/sort_tailwind_classes.js --check && node scripts/git_lineage_auditor.js && node scripts/audit_markdown.js && node scripts/compile_docs_manifest.js && tsc --noEmit && eslint . && knip && node scripts/contrast_check.js",
    "format:classes": "node scripts/sort_tailwind_classes.js",
    "prepare": "node scripts/install-hooks.js",
    "pre-commit": "node scripts/pre-commit.js"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-react": "^0.556.0",
    "marked": "^18.0.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vike": "^0.4.247",
    "vike-react": "^0.6.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^27.2.0",
    "knip": "^6.27.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.103.0"
  }
}
