{
  "name": "qrcraftly",
  "compatibility_date": "2024-09-23",
  "pages_build_output_dir": "dist/client",
  "assets": {
    "directory": "./dist/client",
  },
  "build": {
    "command": "npm install pnpm@11.1.3 --no-save --prefix .pnpm-bin && SKIP_GIT_VALIDATION=1 node .pnpm-bin/node_modules/pnpm/bin/pnpm.cjs install && SKIP_GIT_VALIDATION=1 node .pnpm-bin/node_modules/pnpm/bin/pnpm.cjs run build",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
