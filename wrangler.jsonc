{
  "name": "qrcraftly",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist/client",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qrcraftly-db",
      "database_id": "qrcraftly-d1-id",
    },
  ],
  "build": {
    "command": "NODE_ENV=development npx pnpm install --production=false && SKIP_GIT_VALIDATION=1 npx pnpm run build",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
