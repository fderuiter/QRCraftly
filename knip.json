{
  "entry": [
    "src/pages/**/+*.ts",
    "src/pages/**/+*.tsx",
    "src/layouts/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx"
  ],
  "project": ["src/**/*.ts", "src/**/*.tsx"],
  "ignore": ["src/utils/base64.ts", "experiments/**/*"],
  "paths": {
    "@/*": ["./src/*"]
  },
  "ignoreDependencies": ["wrangler", "tailwindcss"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error"
  }
}
