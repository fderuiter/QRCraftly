{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/pages/**/+*.{ts,tsx}!",
    "src/packages/*/worker*.ts!",
    "src/utils/imageResizeWorker.ts!",
    "scripts/**/*.{js,cjs,ts}!",
    "tests/fixtures/echoWorker.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/packages/edge-redirect/{dev.ts,lib/mockD1.ts,tests/**}!",
    "!src/packages/*/tests/**!",
    "scripts/**/*.{js,cjs,ts}!",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.ts"
  ],
  "paths": {
    "@/*": ["./src/*"]
  },
  "ignoreExportsUsedInFile": true,
  "ignoreFiles": [
    "src/packages/*/index.ts",
    "src/packages/scannability/opticalSimulation.ts"
  ],
  "ignoreIssues": {
    "src/packages/*/*.ts": ["types"],
    "src/packages/scannability/**": ["exports", "types"]
  },
  "ignoreBinaries": ["shellcheck"],
  "ignoreDependencies": ["wrangler", "lint-staged"],
  "husky": false,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error"
  }
}
