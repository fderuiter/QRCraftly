{
  "entry": [
    "src/pages/**/+*.ts",
    "src/pages/**/+*.tsx",
    "src/layouts/**/*.tsx",
    "src/packages/*/*.ts",
    "src/packages/*/lib/worker.ts",
    "src/engine/StreamLookahead.ts",
    "src/hooks/useAnimatedQrReceiver.ts",
    "src/hooks/useAnimatedQrSender.ts",
    "src/utils/FrameMemoryPool.ts",
    "src/utils/fileReassemblyWorker.ts",
    "src/utils/fileSliceWorker.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx"
  ],
  "project": ["src/**/*.ts", "src/**/*.tsx"],
  "paths": {
    "@/*": ["./src/*"]
  },
  "ignoreBinaries": ["shellcheck"],
  "ignoreDependencies": ["wrangler", "bidi-js", "lint-staged"],
  "husky": false,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error"
  }
}
